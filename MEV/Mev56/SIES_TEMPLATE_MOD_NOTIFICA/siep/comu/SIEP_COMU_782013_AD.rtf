\pard\nowidctlpar\qj\lang1040\b0 </wr:forEach></wr:if>\par
\par
Rilevato che <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">il condannato trovasi tuttora\b  \b0 <wr:else/>la condannata trovasi tuttora </wr:if> in espiazione di pena per questa causa\b  in regime di\b0  <\b wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;02&apos;]">Arresti Domociliari\b0 </wr:if><wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;70&apos;]">\b  Arresti Domociliari\b0 </wr:if><wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;71&apos;]">\b Permanenza in Casa\b0 </wr:if><wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;72&apos;]">\b Collocamento in Comunit\'e0</wr:if>, con decorrenza <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizio"/> e fine pena, ad oggi al <wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/>\b0 ;\par
\pard\nowidctlpar\sb120\sa120\qc\b CONSIDERATO\par
\pard\nowidctlpar\qj\tx142\b0 che, alla data odierna, la pena residua risulta essere pari a: \par
\pard\nowidctlpar\qj\b <wr:if select="/X/FascicoloSiep/PenaResidua/StringaReclusione">\b0 Reclusione <wr:out select="/X/FascicoloSiep/PenaResidua/StringaReclusione"/></wr:if><wr:if select="/X/FascicoloSiep/PenaResidua/StringaArresto">Arresto <wr:out select="/X/FascicoloSiep/PenaResidua/StringaArresto"/></wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;S&apos;]">Ergastolo</wr:if> <wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;D&apos;]">Ergastolo con isolamento diurno</wr:if><wr:if select="/X/FascicoloSiep/TotalePeriodoLicenzaAnticipata[TotaleGiorniDaConcedere!=0] or /X/FascicoloSiep/TotalePeriodoLicenzaAnticipata[TotaleGiorniConcessi!=0]">\par
\pard\nowidctlpar\sb40\qj Da cui vanno detratti giorni \b <wr:if select="/X/FascicoloSiep/TotalePeriodoLicenzaAnticipata [TotaleGiorniDaConcedere!=0]\rdblquote ><wr:out select="/X/FascicoloSiep/TotalePeriodoLicenzaAnticipata/TotaleGiorniDaConcedere"/> da concedere </wr:if><wr:if select="/X/FascicoloSiep/TotalePeriodoLicenzaAnticipata[TotaleGiorniConcessi!=0]\rdblquote >\par
\pard\qj <wr:out select="/X/FascicoloSiep/TotalePeriodoLicenzaAnticipata/TotaleGiorniConcessi"/> concessi </wr:if>di liberazione anticipata</wr:if>\par
\pard\nowidctlpar\sb120\sa120\qj\b0 che, calcolata la sopraindicata custodia cautelare sofferta e le eventuali detrazioni previste dall\rquote articolo 54 della legge 26 luglio 1975 n. 354, la pena residua non supera i limiti indicati dall\rquote art. 656 comma 5 c.p.p. del decreto legge 1 luglio 2013 n. 78, convertito in Legge 9 Agosto 2013, n. 94;\par
che non ricorrono i presupposti  per l\rquote applicazione dell\rquote art. 656, comma 9 c.p.p.;\par
\pard\nowidctlpar\sb120\sa120\qc\b ORDINA\par
\pard\sa80\qj\tx142\b0 che l\rquote espiazione della residua pena prosegua \ul\b in regime di\ulnone\b0  <wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;02&apos;]">\ul\b Arresti Domiciliari\ulnone\b0 </wr:if><wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;70&apos;]"> \ul\b Arresti Domiciliari\ulnone\b0 </wr:if><wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;71&apos;]">\ul\b Permanenza in Casa \ulnone\b0 </wr:if><wr:if select="/X/FascicoloSiep/PosizioneGiuridica[CodPosizioneGiuridica=&apos;72&apos;]">\ul\b Collocamento in Comunit\'e0\ulnone\b0 </wr:if>\par
\pard\sa80\qj che il provvedimento conservi i suoi effetti fino alla decisione del Magistrato di Sorveglianza;\par
\pard\nowidctlpar\qj\par
Visto l\rquote art. 656 comma 4 bis e 4 quater c.p.p. decreto legge 1 luglio 2013 n. 78, \cf1 convertito in Legge 9 Agosto 2013, n. 94\cf0 ;\b\par
\pard\sb120\sa120\qc DISPONE\par
\pard\qj\b0 che le autorit\'e0 preposte al controllo vigilino sull\rquote osservanza delle prescrizioni dettate nel verbale di sottoposizione agli obblighi fino al\b  <wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;S&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;D&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;N&apos;]"><wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/></wr:if>,\b0  data in cui<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato dovr\'e0 essere posto in libert\'e0 <wr:else/> la condannata dovr\'e0 essere posta in libert\'e0 </wr:if> per fine pena, se non in espiazione di pena per altra causa;<wr:import inline='true' url="$\{ESECUZIONEMISURASICUREZZA\}" />\par
\pard\nowidctlpar\sb120\sa120\qc\b TRASMETTE\par
\pard\nowidctlpar\qj\b0 gli atti al  Magistrato di Sorveglianza competente affinch\'e9 provveda all\rquote eventuale applicazione della liberazione anticipata. \par
\pard\nowidctlpar\sb120\sa120\qc\b RISERVA\par
\pard\nowidctlpar\qj\b0 L\rquote emissione di successivi provvedimenti dopo la decisione del Magistrato di Sorveglianza.\par
\par
