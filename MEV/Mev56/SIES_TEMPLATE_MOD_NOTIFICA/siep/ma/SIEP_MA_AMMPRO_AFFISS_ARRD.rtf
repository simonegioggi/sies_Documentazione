\pard\sb100\qj\cf0\lang1040 <wr:if select="/X/Evento/Notifica/Avvocato">\cf1 <wr:import inline='true' url="$\{AVVOCATI\}" /></wr:if>\cf0\b\par
\pard\nowidctlpar\sb160\sa160\qc RILEVATO \par
\pard\nowidctlpar\qj\b0 che <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">il condannato<wr:else/>la condannata </wr:if> attualmente si trova in <wr:import inline='true' url="$\{POSIZIONEGIURIDICATITOLO\}" /> con \b decorrenza dal <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizio"/> e scadenza pena al <wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;S&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;D&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua/DataFine"><wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/></wr:if><wr:if select="/X/FascicoloSiep/PenaResidua/DataInizioArresto"> (*)</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua/DataInizioArresto">\par
(*) Scadenza reclusione <wr:out select="/X/FascicoloSiep/PenaResidua/DataFineReclusione"/> - Decorrenza arresto <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizioArresto"/></wr:if>;\par
\pard\nowidctlpar\sb120\sa120\qc\cf1\b0 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodTipoDecisione\cf0 =&apos;03&apos;]\cf1 ">\cf0\b VISTA\b0 <wr:else/>\b VISTO</wr:if>\par
\pard\qj\cf1\b0 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodTipoDecisione\cf0 =&apos;03&apos;]\cf1 ">\cf0 l\rquote ordinanza<wr:else/>il decreto</wr:if>\cf1 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/Ufficio[CodTipoUfficio\cf0 =&apos;TDS&apos;]\cf1 ">del\cf0  <wr:else/> dell\rquote </wr:if><wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrUfficioSorveglianza"/> N. <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/NumeroRegistro"/>/<wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/AnnoRegistro"/> del <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataDecisione"/> che ha disposto \b l\rquote ammissione provvisoria all\rquote affidamento in prova al servizio sociale ex art. 47, comma 4, legge 26 luglio 1975, n. 354 e successive modificazioni, \b0 da svolgersi in \b <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrLuogoProva"/>\b0 ,\par
\pard\nowidctlpar\sb160\sa160\qc\b RITENUTO\par
\pard\qj\b0 che occorre dare urgente esecuzione al citato provvedimento ex art. 659 c.p.p., che per l\rquote effetto deve essere disposta la scarcerazione della persona in oggetto indicata\par
\pard\nowidctlpar\sb160\sa160\qc\b DISPONE\par
\pard\fi-227\li227\qj\tx227\b0\f1\'a7\tab\f0 la scarcerazione <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">del condannato<wr:else/>della condannata</wr:if>\b  \b0 se non in espiazione di pena per altra causa;\par
\pard\fi-227\li227\sb60\qj\tx227\f1\'a7\tab\f0 che<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato<wr:else/> la condannata</wr:if> dovr\'e0 concordare, nei tempi stabiliti \cf1 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodTipoDecisione\cf0 =&apos;03&apos;]\cf1 ">nel\cf0 l\rquote ordinanza,<wr:else/>nel decreto,</wr:if> il giorno in cui si recher\'e0 davanti al Direttore del competente Ufficio Esecuzione Penale Esterna per la sottoscrizione del verbale contenente le prescrizioni, \b sino a quel giorno dovr\'e0 proseguire il regime di detenzione in corso\b0 .\par
\pard\nowidctlpar\sb160\sa160\qc\b COMUNICA\par
\pard\qj\b0 che il provvedimento, \ul adottato in via provvisoria\ulnone  dal Magistrato di Sorveglianza\b , conserva i suoi effetti fino alla decisione definitiva del Tribunale di Sorveglianza\b0 ;\par
\pard\nowidctlpar\sb160\sa160\qc\b DISPONE\par
\pard\qj\b0 che le Autorit\'e0 preposte al controllo vigilino sull\rquote osservanza delle prescrizioni dettate nel verbale di sottoposizione agli obblighi \b fino al <wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;S&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;D&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;N&apos;]"><wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/></wr:if>,\b0  data in cui <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato<wr:else/> la condannata</wr:if> dovr\'e0 essere <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">posto<wr:else/>posta</wr:if> in libert\'e0 per fine pena, se non in espiazione di pena per altra causa. <wr:if select="/X/FascicoloSiep/MisuraSicurezza">\par
\pard\sb60\qj In pari data dovr\'e0 inoltre trovare applicazione la misura di sicurezza:<wr:forEach select="/X/FascicoloSiep/MisuraSicurezza">\par
\pard\nowidctlpar\lang2057 <wr:out select="./DescrTipo"/> <wr:if select=".[NumAnni!=0]"> Anni <wr:out select="./NumAnni"/> </wr:if> <wr:if select=".[NumMesi!=0]"> Mesi <wr:out select="./NumMesi"/> </wr:if> <wr:if select=".[NumGiorni!=0]"> Giorni <wr:out select="./NumGiorni"/>\par
\pard\nowidctlpar\qj\lang1040 </wr:if></wr:forEach> \par
\pard\qj (previo accertamento della persistenza della pericolosit\'e0 sociale da parte del Magistrato di Sorveglianza competente, se non gi\'e0 accertata);</wr:if>\par
\par
