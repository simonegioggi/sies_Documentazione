\pard\nowidctlpar\sb120\sa120\qc\lang1040\b VISTA\par
\pard\qj\b0 l\rquote ordinanza del \cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrUfficioSorveglianza"/>\cf0  N. <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/NumeroRegistro"/>/<wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/AnnoRegistro"/> del <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataDecisione"/>, che ha revocato il beneficio \b dell\rquote esecuzione presso il domicilio della pena detentiva in corso (legge 26.11.2010 n. 199 modificata con decreto-legge 22.12.2011 n. 211)\b0 ,<wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataInizioRevoca"> dal\b  <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataInizioRevoca"/></wr:if>\b0  ordinando l\rquote accompagnamento in Istituto di Detenzione, <\highlight2 wr:if\highlight0  select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[DataInizioRevoca or StringaRevocaReclusione or StringaRevocaArresto]">determinando il residuo pena da espiare in:<wr:else/>per cui il condannato deve espiare la pena di:</wr:if>\par
\pard\sb40\qj\b <wr:if select="\cf1 /X/FascicoloSiep/PenaResidua/StringaReclusione">Reclusione <wr:out select="/X/FascicoloSiep/PenaResidua/StringaReclusione"/> </wr:if><wr:if select="/X/FascicoloSiep/PenaResidua/StringaArresto">\cf0 Arresto <wr:out select="/X/FascicoloSiep/PenaResidua/StringaArresto"/>\b0 </wr:if> da espiarsi in regime di detenzione\b\par
\pard\qj\b0\par
\pard\sb40\qj Poich\'e9 occorre dare esecuzione ex art. 659 c.p.p. al citato provvedimento e che, per l\rquote effetto, deve essere disposta la carcerazione;\par
\par
\pard\nowidctlpar\b <\highlight2 wr:if\highlight0  select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataIngressoIstituto">\par
\pard\nowidctlpar\sb120\sa120\qc DISPONE\par
\pard\nowidctlpar\qj\b0 che la residua pena espianda di cui sopra \b decorra dal <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizio"/>\b0 <\highlight3 wr:if\highlight0  select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[DataInizioRevoca or StringaRevocaReclusione or StringaRevocaArresto]"> (data d\rquote ingresso in Istituto <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">del condannato<wr:else/>della condannata</wr:if> a seguito del sopra descritto decreto di sospensione provvisoria della misura alternativa emesso dal Magistrato di Sorveglianza, con conseguente carcerazione del medesimo) e \b scada il <\highlight3 wr:else\highlight0 />\b0  confermando la \b scadenza pena al </\highlight3 wr:if\highlight0 ><wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/><wr:if select="/X/FascicoloSiep/PenaResidua[DataFineReclusione AND DataInizioArresto]"> (*)</wr:if>\b0 , data in cui dovr\'e0 essere <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">scarcerato<wr:else/>scarcerata</wr:if> se non <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">detenuto<wr:else/>detenuta</wr:if> per altra causa;\cf1 <wr:import inline='true' url="$\{ESECUZIONEMISURASICUREZZA\}" />\cf0 <wr:if select="/X/FascicoloSiep/PenaResidua[DataFineReclusione AND DataInizioArresto]">\par
(*) Scadenza reclusione <wr:out select="/X/FascicoloSiep/PenaResidua/DataFineReclusione"/> - Decorrenza arresto <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizioArresto"/></wr:if>\par
<\highlight2 wr:else/\highlight0 ><wr:if select="/commento">\highlight4 soggetto non detenuto\highlight0 </wr:if>\par
\pard\nowidctlpar\sb120\sa120\qc\b ORDINA\par
\pard\nowidctlpar\qj\b0 agli Ufficiali ed Agenti di Polizia Giudiziaria di procedere alla traduzione <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">del condannato<wr:else/>della condannata</wr:if>, assicurandosi della sua identit\'e0 e previa consegna di copia del presente ordine, presso l\rquote Istituto di Detenzione pi\'f9 vicino al luogo dell\rquote arresto, per l\rquote espiazione della pena residua\par
\par
\pard\nowidctlpar\sb120\sa120\qc\b DISPONE\par
\pard\nowidctlpar\qj\b0\par
\pard\fi-340\li624\qj\tx644\f1\'b7\tab\f0 di consegnare all\rquote Istituto di detenzione in cui <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">il condannato sar\'e0 ristretto<wr:else/>la condannata sar\'e0 ristretta</wr:if>, copia del presente provvedimento;<wr:if select="/X/FascicoloSiep/PenaResidua/DataInizio">\par
\f1\'b7\tab\f0 che la pena di cui sopra, gia' in corso di espiazione, decorrente dal \b <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizio"/>\b0 , avra' termine il \b <wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/>\b0 , data in cui dovr\'e0 essere <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">scarcerato se non detenuto per altra causa<wr:else/>scarcerata se non detenuta per altra causa</wr:if> <wr:if select="/X/FascicoloSiep/MisuraSicurezza">\par
\pard\nowidctlpar\li624\qj in pari data dovr\'e0 inoltre trovare applicazione la misura di sicurezza :<wr:forEach select="/X/FascicoloSiep/MisuraSicurezza">\par
\lang2057 <wr:out select="./DescrTipo"/> <wr:if select="./NumAnni"> Anni <wr:out select="./NumAnni"/> </wr:if> <wr:if select=".[NumMesi!=0]"> Mesi <wr:out select="./NumMesi"/> </wr:if> <wr:if select=".[NumGiorni!=0]"> Giorni <wr:out select="./NumGiorni"/>\par
\pard\li624\qj\lang1040 </wr:if></wr:forEach> (previo accertamento della persistenza della pericolosit\'e0 sociale da parte del Magistrato di Sorveglianza competente, se non gi\'e0 accertata)</wr:if>;</wr:if>\par
\pard\nowidctlpar\qj\par
