\pard\nowidctlpar\sb160\sa160\qc\cf1\b0 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodTipoDecisione\cf0 =&apos;03&apos;]\cf1 ">\cf0\b VISTA\b0 <wr:else/>\b  VISTO</wr:if>\par
\pard\nowidctlpar\qj\cf1\b0 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodTipoDecisione\cf0 =&apos;03&apos;]\cf1 "> \cf0 l\rquote ordinanza<wr:else/>il decreto</wr:if>\cf1 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/Ufficio[CodTipoUfficio\cf0 =&apos;TDS&apos;]\cf1 ">del\cf0  <wr:else/> dell\rquote </wr:if> <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/Ufficio/DescrTipoUfficio"/> \cf1 di <\cf0 wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/Ufficio/DescrComune"/> N. <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/NumeroRegistro"/>/<wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/AnnoRegistro"/> del <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataDecisione"/>\cf1  che ha \cf0 disposto \b l\rquote ammissione provvisoria all\rquote affidamento in prova al servizio sociale ex art. 47, comma 4, legge 26 luglio 1975 n. 354, e successive modificazioni,  \b0 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrLuogoProva"> da svolgersi in: <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrLuogoProva"/>;</wr:if>\par
\pard\nowidctlpar\sb160\sa160\qc\b RITENUTO\par
\pard\nowidctlpar\qj\b0 che occorre dare urgente esecuzione \cf1 <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodTipoDecisione\cf0 =&apos;03&apos;]\cf1 "> \cf0 alla citata ordinanza <wr:else/>al citato decreto</wr:if> ex art. 659 c.p.p., che per l\rquote effetto deve essere disposta la scarcerazione della persona in oggetto indicata;\par
\pard\nowidctlpar\sb160\sa160\qc\b DISPONE\par
\pard\nowidctlpar\qj l\rquote immediata scarcerazione \b0 <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> del condannato<wr:else/> della condannata</wr:if>, se non<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> detenuto<wr:else/> detenuta</wr:if> per altra causa, previa sottoscrizione del verbale che detta le prescrizioni;\par
\pard\nowidctlpar\sb160\sa160\qc\b COMUNICA\par
\pard\qj\b0 che il provvedimento, \ul adottato in via provvisoria\ulnone  dal Magistrato di Sorveglianza, conserva i suoi effetti fino alla decisione definitiva del Tribunale di Sorveglianza;\par
\pard\nowidctlpar\sb160\sa160\qc\b DISPONE\par
\pard\qj\b0 che le Autorit\'e0 preposte al controllo vigilino sull\rquote osservanza delle prescrizioni dettate nel verbale di sottoposizione agli obblighi fino al \b <wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;S&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;D&apos;]">MAI</wr:if><wr:if select="/X/FascicoloSiep/PenaResidua[FlagErgastolo=&apos;N&apos;]"><wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/></wr:if>, \b0 data in cui<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato<wr:else/> la condannata</wr:if> dovr\'e0 essere <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">posto<wr:else/>posta</wr:if> in libert\'e0 per fine pena, se non in espiazione di pena per altra causa;\par
\pard\nowidctlpar\sb160\sa160\qc\b AVVISA\par
\pard\nowidctlpar\qj\b0 <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">il condannato<wr:else/>la condannata</wr:if> che qualora non si attenga alle prescrizioni dettate nel verbale di sottoposizione agli obblighi \b il beneficio verr\'e0 revocato \b0 dal competente Magistrato di Sorveglianza.\par
\par
\lang2057\fs24 <wr:import inline='true' url="$\{TESTO_NOTIFICA_EX_ART_148\}" />\lang1040\fs22\par
