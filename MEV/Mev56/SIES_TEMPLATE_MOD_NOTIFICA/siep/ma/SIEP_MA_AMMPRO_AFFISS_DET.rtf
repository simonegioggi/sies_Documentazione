\pard\nowidctlpar\sb160\sa160\qc\cf0\b\caps Rilevato\par
\pard\nowidctlpar\qj\b0\caps0 che<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato \b\'e8 attualmente detenuto\b0 <wr:else/> la condannata \b\'e8 attualmente detenuta\b0 </wr:if>\b  \b0 presso la \b <wr:out select="/X/FascicoloSiep/LuogoDetenzione/DescrTipoIstituto"/>\b0  \b <wr:out select="/X/FascicoloSiep/LuogoDetenzione/DescrLuogo"/>\b0\par
