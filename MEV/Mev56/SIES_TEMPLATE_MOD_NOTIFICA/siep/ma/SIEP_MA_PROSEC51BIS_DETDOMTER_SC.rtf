\pard\nowidctlpar\sb140\sa140\qc\fs22 <wr:if select="/X/\cf1 FascicoloSiep/PenaResidua/MisuraAlternativa\cf0 [CodTipoDecisione=&apos;03&apos;]"  >\b\caps Vista\b0\caps0 <wr:else/>\b\caps  VistO\b0\caps0 </wr:if>\fs24\par
\pard\nowidctlpar\qj\fs22 <wr:if select="/X/\cf1 FascicoloSiep/PenaResidua/MisuraAlternativa\cf0 [CodTipoDecisione=&apos;03&apos;]"  >l\rquote ordinanza dell\rquote <wr:else/>il decreto dell\rquote </wr:if>\cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrUfficioSorveglianza"/> \cf0 N. \cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/NumeroRegistro"/>\cf0 /\cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/AnnoRegistro"/> \cf0 del \cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataDecisione"/>\cf0\b  che ha concesso \b0 <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> al condannato<wr:else/>alla condannata</wr:if>\b , tenuto conto del cumulo delle pene, la prosecuzione della misura in corso di esecuzione (<wr:if select="\b0 /X/FascicoloSiep/PenaResidua/MisuraAlternativa\b /CodTipoDecisioneMaAt">\b0 <wr:out \b select="\b0 /X/FascicoloSiep/PenaResidua/MisuraAlternativa\b /DescrTipoMisuraMaAt"/> concesso con ordinanza N. \b0 <wr:out \b select="\b0 /X/FascicoloSiep/PenaResidua/MisuraAlternativa\b /AnnoRegistroMaAt"/>/\b0 <wr:out \b select="\b0 /X/FascicoloSiep/PenaResidua/MisuraAlternativa\b /NumeroRegistroMaAt"/> dal \b0 <wr:out \b select="\b0 /X/FascicoloSiep/PenaResidua/MisuraAlternativa\b /DescrChiaveUfficioFascicoloSiusMaAt"/><wr:else/> Differimento Pena Nelle Forme della Detenzione Domiciliare\b0  \b </wr:if>) di cui \b0 <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il medesimo<wr:else/>la medesima</wr:if> \b beneficia in relazione ad altro titolo esecutivo, \b0 per l\rquote espiazione di un periodo di pena \b <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/StringaReclusione">pari a <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/StringaReclusione"/><wr:else/> <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataFineMisura">fino al <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataFineMisura"/></wr:if></wr:if>.\b0\fs24\par
\pard\nowidctlpar\par
\fs22 Poich\'e9 occorre dare esecuzione, ex. art. 659 c.p.p., al citato provvedimento;\fs24\par
\pard\nowidctlpar\sb140\sa140\qc\b\fs22 COMUNICA\b0\fs24\par
\pard\nowidctlpar\qj\fs22 che la misura della Detenzione Domiciliare a\b  termine \b0 in corso di esecuzione \b di cui \b0 <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">il medesimo<wr:else/>la medesima</wr:if>\b  attualmente beneficia in relazione ad altro titolo esecutivo, \b0 <wr:if select=\rdblquote /X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodNaturaDecisione=\rquote ED\rquote ]\rdblquote >\b prosegua\b0 ,\b  ex art. 51 bis Legge 26 Luglio 1975 N. 534, e successive modificazioni\b0   per il nuovo titolo, \b in regime di \b0 <wr:if \b select="\b0 /X/FascicoloSiep/PenaResidua/MisuraAlternativa\b /CodTipoDecisioneMaAt"><wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrTipoMisuraMaAt"/><wr:else/>\b0  \b Differimento Pena Nelle Forme della Detenzione Domiciliare\b0  \b </wr:if><wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataFineMisura"> fino al <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataFineMisura"/></wr:if>; \b0 <wr:else/><wr:if select=\rdblquote /X/FascicoloSiep/PenaResidua/MisuraAlternativa[CodNaturaDecisione=\rquote EC\rquote ]\rdblquote >\b prosegua\b0 , \b ex art. 51 bis Legge 26 Luglio 1975 N. 534, e successive modificazioni\b0  \b in regime di <wr:out select="/X/FascicoloSiep/PosizioneGiuridica/DescrPosizioneGiuridica"/>;</wr:if></wr:if>\b0\fs24\par
\par
\pard\nowidctlpar\sb160\sa160\qc\b\fs22 DISPONE\b0\fs24\par
\pard\nowidctlpar\qj\fs22 che l\rquote autorit\'e0 di Polizia vigili sull\rquote osservanza delle prescrizioni dettate nel verbale di sottoposizione agli obblighi fino al <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataFineMisura"/> \b data in cui<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato dovr\'e0 essere tradotto<wr:else/> la condannata dovr\'e0 essere tradotta</wr:if>, a cura dell\rquote Autorit\'e0 di polizia territorialmente competente, nel pi\'f9 vicino Istituto di detenzione\b0  per la prosecuzione dell\rquote espiazione della pena\b <wr:if select="/X/FascicoloSiep/PenaResidua/DataFine"> \b0 che\b  scadr\'e0\b0  \b il <wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/>\b0 , data in cui dovr\'e0 essere<wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> scarcerato se non detenuto<wr:else/> scarcerata se non detenuta</wr:if> per altra causa</wr:if>;\par
\par
