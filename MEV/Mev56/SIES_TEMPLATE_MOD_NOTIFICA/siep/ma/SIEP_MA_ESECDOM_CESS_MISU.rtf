\pard\nowidctlpar\sb160\sa160\qc\lang1040 <wr:if select="/X/\cf1 FascicoloSiep/PenaResidua/MisuraAlternativa\cf0 [CodTipoDecisione=&apos;03&apos;]"  >\b\caps Vista\b0\caps0 <wr:else/>\b\caps  VistO\b0\caps0 </wr:if>\b\caps\par
\pard\nowidctlpar\qj\b0\caps0 <wr:if select="/X/\cf1 FascicoloSiep/PenaResidua/MisuraAlternativa\cf0 [CodTipoDecisione=&apos;03&apos;]"  >l\rquote ordinanza dell\rquote <wr:else/>il decreto dell\rquote </wr:if>\cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DescrUfficioSorveglianza"/> \cf0 N. \cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/NumeroRegistro"/>\cf0 /\cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/AnnoRegistro"/> \cf0 del \cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataDecisione"/> \cf0 che ha dichiarato cessata la misura alternativa \b dell\rquote esecuzione presso il domicilio della pena detentiva (legge 26.11.2010 n. 199 modificata con decreto-legge 22.12.2011 n. 211)\b0 , <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa[Is51Bis=&apos;S&apos;]"> \b per sopravvenienza nuovo titolo esecutivo ex art. 51 bis Legge 22 dicembre 1975, n. 685  e successive modificazioni,\b0  </wr:if> <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataInizioRevoca"> con decorrenza \cf1 <wr:out select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataInizioRevoca"/></wr:if>\cf0 per cui <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]"> il condannato <wr:else/> la condannata </wr:if>deve espiare la residua pena di\b  \b0 <wr:if select="/X/FascicoloSiep/PenaResidua/StringaReclusione">\b Reclusione\b0  \b <wr:out select="/X/FascicoloSiep/PenaResidua/StringaReclusione"/></wr:if> <wr:if select="/X/FascicoloSiep/PenaResidua/StringaArresto">\par
\cf1 Arresto <wr:out select="/X/FascicoloSiep/PenaResidua/StringaArresto"/></wr:if> \b0 in regime di detenzione;\par
\pard\nowidctlpar\sb100\qj\cf0\par
\pard\nowidctlpar\qj Poich\'e9 occorre dare esecuzione ex art. 659 c.p.p. al citato provvedimento e che, per l\rquote effetto, deve essere disposta la carcerazione;\par
\pard\sb100\qj\cf1\lang2057 <wr:import inline='true' url="$\{AVVOCATI\}" />\par
\pard\nowidctlpar\sb160\sa160\qc\cf0\lang1040\b DISPONE\par
\pard\nowidctlpar <wr:if select="/X/FascicoloSiep/PenaResidua/MisuraAlternativa/DataIngressoIstituto">\par
\pard\nowidctlpar\qj\b0 che la residua pena espianda di cui sopra \b decorra dal <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizio"/>\b0  e \b scada il <wr:out select="/X/FascicoloSiep/PenaResidua/DataFine"/><wr:if select="/X/FascicoloSiep/PenaResidua/DataInizioArresto"> (*)</wr:if>\b0 , data in cui dovr\'e0 essere <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">scarcerato<wr:else/>scarcerata</wr:if> se non <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">detenuto<wr:else/>detenuta</wr:if> per altra causa;\cf1 <wr:import inline='true' url="$\{ESECUZIONEMISURASICUREZZA\}" />\cf0 <wr:if select="/X/FascicoloSiep/PenaResidua/DataInizioArresto">\par
(*) Scadenza reclusione <wr:out select="/X/FascicoloSiep/PenaResidua/DataFineReclusione"/> - Decorrenza arresto <wr:out select="/X/FascicoloSiep/PenaResidua/DataInizioArresto"/></wr:if><wr:else/>\par
La carcerazione del condannato per l\rquote espiazione sopra indicata di:\par
\b <wr:if select="\cf1 /X/FascicoloSiep/PenaResidua/StringaReclusione">Reclusione <wr:out select="/X/FascicoloSiep/PenaResidua/StringaReclusione"/>\cf0 </wr:if>\cf1  <wr:if select="/X/FascicoloSiep/PenaResidua/StringaArresto">\cf0\par
Arresto <wr:out select="/X/FascicoloSiep/PenaResidua/StringaArresto"/></wr:if>\par
\pard\nowidctlpar\sb160\sa160\qc ORDINA\par
\pard\nowidctlpar\qj\b0 agli Ufficiali ed Agenti di Polizia Giudiziaria di procedere all\rquote arresto e alla traduzione <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">del condannato<wr:else/>della condannata</wr:if>, assicurandosi della sua identit\'e0 e previa consegna di copia del presente ordine, presso l\rquote Istituto di Detenzione pi\'f9 vicino al luogo dell\rquote arresto, per l\rquote espiazione della pena di cui sopra;\b </wr:if>\par
\par
\lang2057\b0\fs24 <wr:import inline='true' url="$\{TESTO_NOTIFICA_EX_ART_148\}" />\lang1040\b\fs22\par
