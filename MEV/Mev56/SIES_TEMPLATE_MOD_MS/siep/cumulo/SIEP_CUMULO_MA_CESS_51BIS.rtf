- <wr:out select="X/IstruttoriaCumulo/PenaRideterminataCumulo[FlagPenaResiduaCumulo=&apos;S&apos;]/StringaErgastolo"/></wr:if><wr:if select="X/IstruttoriaCumulo/PenaRideterminataCumulo[FlagPenaResiduaCumulo=&apos;S&apos;]/StringaReclusione">\par
