\pard\qj\b0 <wr:if select="/X/Soggetto[Sesso=&apos;M&apos;]">il condannato<wr:else/>la condannata</wr:if> che qualora non si attenga alle prescrizioni dettate nel verbale di sottoposizione agli obblighi, \b il beneficio verr\'e0 revocato\b0 .\par
\pard\keepn\s1\sb120\sa120\qc\b MANDA\par
