CREATE OR REPLACE PROCEDURE XBA_BONIFICA_AVV_CON_PENDENZE IS

	-- variabili per la FETCH del COUSORE di XBA_AVVOCATI_CON_PENDENZE.
	V_ID_AVVOCATO					XBA_AVVOCATI_CON_PENDENZE.ID_AVVOCATO%TYPE;
	V_COGNOME						XBA_AVVOCATI_CON_PENDENZE.COGNOME%TYPE;
	V_NOME							XBA_AVVOCATI_CON_PENDENZE.NOME%TYPE;
	V_FORO							XBA_AVVOCATI_CON_PENDENZE.FORO%TYPE;
	V_INDIRIZZO						XBA_AVVOCATI_CON_PENDENZE.INDIRIZZO%TYPE;
	V_TELEFONO						XBA_AVVOCATI_CON_PENDENZE.TELEFONO%TYPE;
	V_FAX							XBA_AVVOCATI_CON_PENDENZE.FAX%TYPE;
	V_E_MAIL						XBA_AVVOCATI_CON_PENDENZE.E_MAIL%TYPE;
	V_COD_COMUNE_RESIDENZA			XBA_AVVOCATI_CON_PENDENZE.COD_COMUNE_RESIDENZA%TYPE;
	V_COD_LUOGO_NASCITA				XBA_AVVOCATI_CON_PENDENZE.COD_LUOGO_NASCITA%TYPE;
	V_DATA_NASCITA					XBA_AVVOCATI_CON_PENDENZE.DATA_NASCITA%TYPE;
	V_DATA_SOSPESO_FINO_AL			XBA_AVVOCATI_CON_PENDENZE.DATA_SOSPESO_FINO_AL%TYPE;
	V_DATA_RADIATO_DAL				XBA_AVVOCATI_CON_PENDENZE.DATA_RADIATO_DAL%TYPE;
	V_COD_NON_ATTIVITA				XBA_AVVOCATI_CON_PENDENZE.COD_NON_ATTIVITA%TYPE;
	V_NOTE							XBA_AVVOCATI_CON_PENDENZE.NOTE%TYPE;
	V_FLAG_CANCELLATO				XBA_AVVOCATI_CON_PENDENZE.FLAG_CANCELLATO%TYPE;
	V_COD_UFFICIO_APPARTENENZA		XBA_AVVOCATI_CON_PENDENZE.COD_UFFICIO_APPARTENENZA%TYPE;
	V_COD_OPERATORE_INSERIMENTO		XBA_AVVOCATI_CON_PENDENZE.COD_OPERATORE_INSERIMENTO%TYPE;
	V_DATA_INSERIMENTO				XBA_AVVOCATI_CON_PENDENZE.DATA_INSERIMENTO%TYPE;
	V_COD_UFFICIO_INSERIMENTO		XBA_AVVOCATI_CON_PENDENZE.COD_UFFICIO_INSERIMENTO%TYPE;
	V_COD_OPERATORE_AGGIORNAMENTO	XBA_AVVOCATI_CON_PENDENZE.COD_OPERATORE_AGGIORNAMENTO%TYPE;
	V_DATA_AGGIORNAMENTO			XBA_AVVOCATI_CON_PENDENZE.DATA_AGGIORNAMENTO%TYPE;
	V_COD_UFFICIO_AGGIORNAMENTO		XBA_AVVOCATI_CON_PENDENZE.COD_UFFICIO_AGGIORNAMENTO%TYPE;
	V_COD_FISCALE					XBA_AVVOCATI_CON_PENDENZE.COD_FISCALE%TYPE;
	V_PROVINCIA						XBA_AVVOCATI_CON_PENDENZE.PROVINCIA%TYPE;
	V_CAP							XBA_AVVOCATI_CON_PENDENZE.CAP%TYPE;
	V_ID_AVVOCATO_STANDARD			XBA_AVVOCATI_CON_PENDENZE.ID_AVVOCATO_STANDARD%TYPE;
	V_FLAG_VISUALIZZA				XBA_AVVOCATI_CON_PENDENZE.FLAG_VISUALIZZA%TYPE;
	V_PEC							XBA_AVVOCATI_CON_PENDENZE.PEC%TYPE;
	V_FLAG_REGINDE					XBA_AVVOCATI_CON_PENDENZE.FLAG_REGINDE%TYPE;
	V_DESCR_COMUNE_STUDIO			XBA_AVVOCATI_CON_PENDENZE.DESCR_COMUNE_STUDIO%TYPE;
	V_AMBIENTE						XBA_AVVOCATI_CON_PENDENZE.AMBIENTE%TYPE;
	V_NUM_PENDENZE					XBA_AVVOCATI_CON_PENDENZE.NUM_PENDENZE%TYPE;
	V_ID_AVV_CERT_REGINDE			XBA_AVVOCATI_CON_PENDENZE.ID_AVV_CERT_REGINDE%TYPE;
	V_COD_STATO_NASCITA_AVV			XBA_AVVOCATI_CON_PENDENZE.COD_STATO_NASCITA_AVV%TYPE;
	V_DESC_LUOGO_NAS_REGINDE		XBA_AVVOCATI_CON_PENDENZE.DESC_LUOGO_NAS_REGINDE%TYPE;
	V_ID_AVVOCATO_BONIFICATO		XBA_AVVOCATI_CON_PENDENZE.ID_AVVOCATO_BONIFICATO%TYPE;

	-- variabili per la SELECT puntuale di AVVOCATO_REGINDE_18112020.
	V_AR_NOME						AVVOCATO_REGINDE_18112020.NOME%TYPE;
	V_AR_COGNOME					AVVOCATO_REGINDE_18112020.COGNOME%TYPE;
	V_AR_CODFISC					AVVOCATO_REGINDE_18112020.CODFISC%TYPE;
	V_AR_DT_NASCITA					AVVOCATO_REGINDE_18112020.DT_NASCITA%TYPE;
	V_AR_LUOGO_NASCITA				AVVOCATO_REGINDE_18112020.LUOGO_NASCITA%TYPE;
	V_AR_PROV_NASCITA				AVVOCATO_REGINDE_18112020.PROV_NASCITA%TYPE;
	V_AR_PEC						AVVOCATO_REGINDE_18112020.PEC%TYPE;
	V_AR_DESCR						AVVOCATO_REGINDE_18112020.DESCR%TYPE;
	V_AR_CODICE						AVVOCATO_REGINDE_18112020.CODICE%TYPE;
	V_AR_DESCR_1					AVVOCATO_REGINDE_18112020.DESCR_1%TYPE;
	V_AR_TP_INDIRIZZO				AVVOCATO_REGINDE_18112020.TP_INDIRIZZO%TYPE;
	V_AR_INDIRIZZO					AVVOCATO_REGINDE_18112020.INDIRIZZO%TYPE;
	V_AR_CAP						AVVOCATO_REGINDE_18112020.CAP%TYPE;
	V_AR_COMUNE						AVVOCATO_REGINDE_18112020.COMUNE%TYPE;
	V_AR_PROV						AVVOCATO_REGINDE_18112020.PROV%TYPE;
	V_AR_COD_CATASTO				AVVOCATO_REGINDE_18112020.COD_CATASTO%TYPE;
	V_AR_COD_COMUNE					AVVOCATO_REGINDE_18112020.COD_COMUNE%TYPE;
	V_AR_COD_NAZIONE				AVVOCATO_REGINDE_18112020.COD_NAZIONE%TYPE;

	-- variabile generali
	AVV_CON_PENDENZE_tot   	NUMBER:=0;
	AVV_MATCH_REGINDE	  	NUMBER:=0;
	AVV_NOMATCH_REGINDE	  	NUMBER:=0;
	AVV_CON_PENDENZE_agg	NUMBER:=0;
	AVV_CERT_REGINDE		NUMBER:=0;
	AVV_COLLEGATI			NUMBER:=0;

	is_found_avv_reginde boolean := false; 

	ID_AVV_CERT_REGINDE_attuale		XBA_AVVOCATI_CON_PENDENZE.ID_AVV_CERT_REGINDE%TYPE;
	COD_FISCALE_attuale				XBA_AVVOCATI_CON_PENDENZE.COD_FISCALE%TYPE;
	COD_FISCALE_letto				XBA_AVVOCATI_CON_PENDENZE.COD_FISCALE%TYPE;
	ID_AVVOCATO_letto				XBA_AVVOCATI_CON_PENDENZE.ID_AVVOCATO%TYPE;
	FLAG_REGINDE_attuale			XBA_AVVOCATI_CON_PENDENZE.FLAG_REGINDE%TYPE;

	-- Cursore xba_avvocati_con_pendenze
	CURSOR cur_avv_con_pendenze IS
		SELECT ID_AVVOCATO, COGNOME, NOME, FORO, INDIRIZZO, TELEFONO, FAX, E_MAIL, COD_COMUNE_RESIDENZA,
			   COD_LUOGO_NASCITA, DATA_NASCITA, DATA_SOSPESO_FINO_AL, DATA_RADIATO_DAL, COD_NON_ATTIVITA,
			   NOTE, FLAG_CANCELLATO, COD_UFFICIO_APPARTENENZA, COD_OPERATORE_INSERIMENTO, DATA_INSERIMENTO,
			   COD_UFFICIO_INSERIMENTO, COD_OPERATORE_AGGIORNAMENTO, DATA_AGGIORNAMENTO, COD_UFFICIO_AGGIORNAMENTO,
			   COD_FISCALE, PROVINCIA, CAP, ID_AVVOCATO_STANDARD, FLAG_VISUALIZZA, PEC, FLAG_REGINDE, DESCR_COMUNE_STUDIO,
			   AMBIENTE, NUM_PENDENZE, ID_AVV_CERT_REGINDE, COD_STATO_NASCITA_AVV, DESC_LUOGO_NAS_REGINDE, ID_AVVOCATO_BONIFICATO
			   
		  FROM XBA_AVVOCATI_CON_PENDENZE
		 ORDER BY COD_FISCALE ASC, DATA_INSERIMENTO DESC, ID_AVVOCATO DESC;

	-- Cursore avvocati di REGINDE
	CURSOR cur_avv_reginde(V_NOME IN VARCHAR2, V_COGNOME IN VARCHAR2,V_FORO IN VARCHAR2, V_COD_FISCALE IN VARCHAR2, 
						   V_COD_LUOGO_NASCITA IN VARCHAR2, V_DATA_NASCITA IN DATE ) IS
		SELECT ar.*
		  FROM AVVOCATO_REGINDE_18112020 ar
		 WHERE UPPER(ar.COGNOME) = UPPER(V_COGNOME)
		   AND UPPER(ar.NOME) = UPPER(V_NOME)
		   AND UPPER(SUBSTR(ar.DESCR , 5)) = UPPER(V_FORO)
		   AND (V_COD_FISCALE IS NOT NULL AND upper(V_COD_FISCALE) = UPPER(ar.CODFISC) )
		   AND V_COD_LUOGO_NASCITA = ar.COD_COMUNE
		   AND V_DATA_NASCITA = ar.DT_NASCITA;

BEGIN
----------------------------------------------------------
-------------------INIZIO PROCEDURA-----------------------
----------------------------------------------------------

  -- Caricamento tabella XBA_LOG_BONIFICA_AVVOCATI
   BEGIN
      INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
      VALUES('Inizio XBA_BONIFICA_AVV_CON_PENDENZE. Scansione degli Avvocati con pendenze ordinati per COD_FISCALE, DATA_INSERIMENTO e ID_AVVOCATO decrescenti; si individua così prima l AVVOCATO principale.',
              NULL,
              CURRENT_DATE);
   END;
	
  -- Inizializzazione variabile di controllo
  COD_FISCALE_attuale := 0;
  
  -- Scansione degli Avvocati con pendenze ordinati per COD_FISCALE, DATA_INSERIMENTO e ID_AVVOCATO decrescenti, 
  -- al fine di individuare prima l'occorrenza di AVVOCATO "capostipite" verso cui far confluire le altre
  -- occorrenze afferenti allo stesso AVVOCATO. 
  -- Si individua anche il corrispondente Avvocato da REGINDE per aggiornamento dati.
  OPEN cur_avv_con_pendenze;
	LOOP
		FETCH cur_avv_con_pendenze INTO
			V_ID_AVVOCATO, V_COGNOME, V_NOME, V_FORO, V_INDIRIZZO, V_TELEFONO, V_FAX, V_E_MAIL,V_COD_COMUNE_RESIDENZA,
			V_COD_LUOGO_NASCITA, V_DATA_NASCITA, V_DATA_SOSPESO_FINO_AL, V_DATA_RADIATO_DAL, V_COD_NON_ATTIVITA,
			V_NOTE, V_FLAG_CANCELLATO, V_COD_UFFICIO_APPARTENENZA, V_COD_OPERATORE_INSERIMENTO, V_DATA_INSERIMENTO,
			V_COD_UFFICIO_INSERIMENTO, V_COD_OPERATORE_AGGIORNAMENTO, V_DATA_AGGIORNAMENTO, V_COD_UFFICIO_AGGIORNAMENTO,
			V_COD_FISCALE, V_PROVINCIA, V_CAP, V_ID_AVVOCATO_STANDARD, V_FLAG_VISUALIZZA, V_PEC, V_FLAG_REGINDE, 
			V_DESCR_COMUNE_STUDIO, V_AMBIENTE, V_NUM_PENDENZE, V_ID_AVV_CERT_REGINDE, V_COD_STATO_NASCITA_AVV, 
			V_DESC_LUOGO_NAS_REGINDE, V_ID_AVVOCATO_BONIFICATO;

		EXIT WHEN cur_avv_con_pendenze%NOTFOUND;
 		BEGIN
			--DBMS_OUTPUT.PUT_LINE('Avvocato con pendenze : '||V_COGNOME || '  ' ||V_NOME);
			AVV_CON_PENDENZE_tot := AVV_CON_PENDENZE_tot + 1 ;
			COD_FISCALE_letto := V_COD_FISCALE ;
			ID_AVVOCATO_letto := V_ID_AVVOCATO ;
		
			-- Individuazione Avvocato da REGINDE
			is_found_avv_reginde := false; 
			OPEN cur_avv_reginde(V_NOME, V_COGNOME, V_FORO, V_COD_FISCALE, V_COD_LUOGO_NASCITA, V_DATA_NASCITA);
				LOOP
	                FETCH cur_avv_reginde INTO
							V_AR_NOME, V_AR_COGNOME, V_AR_CODFISC, V_AR_DT_NASCITA, V_AR_LUOGO_NASCITA, V_AR_PROV_NASCITA,
							V_AR_PEC, V_AR_DESCR, V_AR_CODICE, V_AR_DESCR_1, V_AR_TP_INDIRIZZO, V_AR_INDIRIZZO,
							V_AR_CAP, V_AR_COMUNE, V_AR_PROV, V_AR_COD_CATASTO, V_AR_COD_COMUNE, V_AR_COD_NAZIONE;
	
	                EXIT WHEN cur_avv_reginde%NOTFOUND;
	                 BEGIN

						is_found_avv_reginde := true;
	
						AVV_MATCH_REGINDE := AVV_MATCH_REGINDE + 1 ;

						-- Eventuale aggiornamento di ID_AVV_CERT_REGINDE_attuale (capostipite) in caso di nuovo C.F. 
						-- Impostazione di FLAG_REGINDE_attuale a 'SI' o a 'NO' in caso di nuovo C.F o di una ripetizione.
						IF (COD_FISCALE_letto = COD_FISCALE_attuale) THEN
							FLAG_REGINDE_attuale := 'NO';
							AVV_COLLEGATI := AVV_COLLEGATI + 1 ;
						
							UPDATE XBA_AVVOCATI_CON_PENDENZE 
							SET FLAG_REGINDE = FLAG_REGINDE_attuale,
								ID_AVV_CERT_REGINDE = ID_AVV_CERT_REGINDE_attuale
							WHERE ID_AVVOCATO = V_ID_AVVOCATO;
						ELSE
							FLAG_REGINDE_attuale := 'SI';
							AVV_CERT_REGINDE := AVV_CERT_REGINDE + 1 ;
							COD_FISCALE_attuale := COD_FISCALE_letto;
							ID_AVV_CERT_REGINDE_attuale := ID_AVVOCATO_letto;

							UPDATE XBA_AVVOCATI_CON_PENDENZE 
							SET FLAG_REGINDE = FLAG_REGINDE_attuale,
								DESCR_COMUNE_STUDIO = V_AR_COMUNE,
								ID_AVV_CERT_REGINDE = ID_AVV_CERT_REGINDE_attuale,
								COD_STATO_NASCITA_AVV = V_AR_COD_NAZIONE,
								DESC_LUOGO_NAS_REGINDE = V_AR_LUOGO_NASCITA,
								PEC = V_AR_PEC,
								INDIRIZZO = V_AR_INDIRIZZO
							WHERE ID_AVVOCATO = V_ID_AVVOCATO;
						END IF;
	                    
						IF(SQL%ROWCOUNT=0) THEN
							dbms_output.put_line('===========================================================');
							dbms_output.put_line('ERRORE UPDATE XBA_AVVOCATI_CON_PENDENZE = '||V_ID_AVVOCATO);
							INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
								 VALUES('ERRORE UPDATE XBA_AVVOCATI_CON_PENDENZE = '||V_ID_AVVOCATO ,
										 NULL,
										 SYSDATE);
						ELSE
							AVV_CON_PENDENZE_agg := AVV_CON_PENDENZE_agg+1;
						END IF;
	
	                  END;
	
				END LOOP;
			
			-- Aggiornamento avvocato in XBA_AVVOCATI_CON_PENDENZE in caso di assenza match con REGINDE
			IF NOT is_found_avv_reginde THEN 
				AVV_NOMATCH_REGINDE := AVV_NOMATCH_REGINDE + 1 ;
			END IF;
	
			CLOSE cur_avv_reginde;

		END;
	
	END LOOP;

  CLOSE cur_avv_con_pendenze;
 
	dbms_output.put_line('==================================================');
    dbms_output.put_line('=  Totale Avvocati con pendenze          : '||AVV_CON_PENDENZE_tot );
    dbms_output.put_line('=');
    dbms_output.put_line('=  Avvocati presenti in REGINDE          : '||AVV_MATCH_REGINDE );
    dbms_output.put_line('=');
    dbms_output.put_line('=  Avvocati assenti in REGINDE           : '||AVV_NOMATCH_REGINDE );
    dbms_output.put_line('=');
    dbms_output.put_line('=  Avvocati certificati REGINDE          : '||AVV_CERT_REGINDE );
    dbms_output.put_line('=');
    dbms_output.put_line('=  Avvocati collegati                    : '||AVV_COLLEGATI );
    dbms_output.put_line('=');
    dbms_output.put_line('=  Avvocati con pendenze aggiornati      : '||AVV_CON_PENDENZE_agg );
    dbms_output.put_line('=');
	dbms_output.put_line('==================================================');

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('==================================================',
			NULL,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('=  Totale Avvocati con pendenze          : ',
			AVV_CON_PENDENZE_tot,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('=  Avvocati presenti in REGINDE          : ',
			AVV_MATCH_REGINDE,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('=  Avvocati assenti in REGINDE           : ',
			AVV_NOMATCH_REGINDE,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('=  Avvocati certificati REGINDE          : ',
			AVV_CERT_REGINDE,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('=  Avvocati collegati                    : ',
			AVV_COLLEGATI,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('=  Avvocati con pendenze aggiornati      : ',
			AVV_CON_PENDENZE_agg,
			CURRENT_DATE);

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('==================================================',
			NULL,
			CURRENT_DATE);
	
	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('Fine XBA_BONIFICA_AVV_CON_PENDENZE. ',
			NULL,
			CURRENT_DATE);

END XBA_BONIFICA_AVV_CON_PENDENZE;
