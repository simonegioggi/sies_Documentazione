--- Backup delle tabelle aggiornate dalla procedura di Bonifica e creazione delle relative tabelle di logs (_BONIF)
CREATE OR REPLACE PROCEDURE SIESPZ.XBA_SALVA_TABELLE_AVVOCATI IS

BEGIN
    -- Caricamento tabella XBA_LOG_BONIFICA_AVVOCATI - Inizio XBA_SALVA_TABELLE_AVVOCATI.
    INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
    VALUES('Inizio XBA_SALVA_TABELLE_AVVOCATI. Salvataggio in copia delle tabelle AVVOCATO, AVVOCATO_FASCICOLO_SIEP, AVVOCATO_FASCICOLO_SIUS, AVVOCATO_FASCICOLO_SIGE, PARTI_UDIENZA_DIFENSORE, STORICO_AVVOCATO, AVVISI_AVVOCATO, NUOVA_ISTANZA  aggiungendo il suffisso _SXBA (Salvataggio per bonifica Avvocati). ',
            NULL,
            CURRENT_DATE);
    
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_SXBA AS SELECT * FROM AVVOCATO' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_FASCICOLO_SIEP_SXBA AS SELECT * FROM AVVOCATO_FASCICOLO_SIEP' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_FASCICOLO_SIUS_SXBA AS SELECT * FROM AVVOCATO_FASCICOLO_SIUS' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_FASCICOLO_SIGE_SXBA AS SELECT * FROM AVVOCATO_FASCICOLO_SIGE' ;
    EXECUTE IMMEDIATE 'CREATE TABLE PARTI_UDIENZA_DIFENSORE_SXBA AS SELECT * FROM PARTI_UDIENZA_DIFENSORE' ;
    EXECUTE IMMEDIATE 'CREATE TABLE STORICO_AVVOCATO_SXBA AS SELECT * FROM STORICO_AVVOCATO' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVISI_AVVOCATO_SXBA AS SELECT * FROM AVVISI_AVVOCATO' ;
    EXECUTE IMMEDIATE 'CREATE TABLE NUOVA_ISTANZA_SXBA AS SELECT * FROM NUOVA_ISTANZA' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_BONIF AS SELECT * FROM AVVOCATO' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_FASCICOLO_SIEP_BONIF AS SELECT * FROM AVVOCATO_FASCICOLO_SIEP' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_FASCICOLO_SIUS_BONIF  AS SELECT * FROM AVVOCATO_FASCICOLO_SIUS' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVOCATO_FASCICOLO_SIGE_BONIF  AS SELECT * FROM AVVOCATO_FASCICOLO_SIGE' ;
    EXECUTE IMMEDIATE 'CREATE TABLE PARTI_UDIENZA_DIFENSORE_BONIF  AS SELECT * FROM PARTI_UDIENZA_DIFENSORE' ;
    EXECUTE IMMEDIATE 'CREATE TABLE STORICO_AVVOCATO_BONIF  AS SELECT * FROM STORICO_AVVOCATO' ;
    EXECUTE IMMEDIATE 'CREATE TABLE AVVISI_AVVOCATO_BONIF  AS SELECT * FROM AVVISI_AVVOCATO' ;
    EXECUTE IMMEDIATE 'CREATE TABLE NUOVA_ISTANZA_BONIF  AS SELECT * FROM NUOVA_ISTANZA' ;

    -- Caricamento tabella XBA_LOG_BONIFICA_AVVOCATI - Fine XBA_SALVA_TABELLE_AVVOCATI.
    INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
    VALUES('Fine XBA_SALVA_TABELLE_AVVOCATI. ',
            NULL,
            CURRENT_DATE);

END XBA_SALVA_TABELLE_AVVOCATI;
/