---  Aggiunta di 6 nuove colonne sulla tabella AVVOCATO e Aggiunta della colonna  AVV_ID_AVVOCATO_NEW sulle tabelle di logs (_BONIF) delle tabelle aggiornate dalla Bonifica
CREATE OR REPLACE PROCEDURE SIESPZ.XBA_MODIFICA_AVVOCATO IS
BEGIN

    -- Caricamento tabella XBA_LOG_BONIFICA_AVVOCATI - Inizio XBA_MODIFICA_AVVOCATO.
    INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
    VALUES('Inizio XBA_MODIFICA_AVVOCATO. Aggiunta di 6 colonne (PEC, FLAG_REGINDE, DESCR_COMUNE_STUDIO, COD_STATO_NASCITA_AVV, DESC_LUOGO_NAS_REGINDE, ID_AVVOCATO_BONIFICATO), funzionali alla bonifica Avvocati e alla nuova gestione di AVVOCATO con certificazione REGINDE. ',
            NULL,
            CURRENT_DATE);

    EXECUTE IMMEDIATE 'ALTER TABLE AVVOCATO 
                               ADD ( PEC VARCHAR2(200),
                                     FLAG_REGINDE VARCHAR2(2),
                                     DESCR_COMUNE_STUDIO VARCHAR2(200),
                                     COD_STATO_NASCITA_AVV VARCHAR2(3),
                                     DESC_LUOGO_NAS_REGINDE VARCHAR2(200),
                                     ID_AVVOCATO_BONIFICATO NUMBER(38,0) )';    
    EXECUTE IMMEDIATE 'ALTER TABLE AVVOCATO_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE AVVOCATO_FASCICOLO_SIEP_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE AVVOCATO_FASCICOLO_SIUS_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE AVVOCATO_FASCICOLO_SIGE_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE PARTI_UDIENZA_DIFENSORE_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE STORICO_AVVOCATO_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE AVVISI_AVVOCATO_BONIF  ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
    EXECUTE IMMEDIATE 'ALTER TABLE NUOVA_ISTANZA_BONIF ADD ( AVV_ID_AVVOCATO_NEW NUMBER(38,0) )';
                                                                     

    INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
    VALUES('Fine XBA_MODIFICA_AVVOCATO. ',
            NULL,
            CURRENT_DATE);

END XBA_MODIFICA_AVVOCATO;
/