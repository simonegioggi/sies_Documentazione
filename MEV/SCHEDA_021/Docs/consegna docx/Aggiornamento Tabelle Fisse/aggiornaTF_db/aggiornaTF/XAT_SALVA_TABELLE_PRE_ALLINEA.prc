CREATE OR REPLACE PROCEDURE XAT_SALVA_TABELLE_PRE_ALLINEA IS

BEGIN
	-- SALVATAGGIO tabelle COMUNE, CG_REF_CODES E CODICI_SIES_NSC prima dell'avvio procedura di allineamento
        -- a tabelle fisse COMUNE, PROVINCIA, REGIONE, STATO-NAZIONE della DGSIA
	
	EXECUTE IMMEDIATE 'CREATE TABLE COMUNE_SXALLTF AS SELECT * FROM COMUNE' ;
	EXECUTE IMMEDIATE 'CREATE TABLE CG_REF_CODES_SXALLTF AS SELECT * FROM CG_REF_CODES' ;
	EXECUTE IMMEDIATE 'CREATE TABLE CODICI_SIES_NSC_SXALLTF AS SELECT * FROM CODICI_SIES_NSC' ;
	EXECUTE IMMEDIATE 'CREATE TABLE COMUNI_SXALLTF AS SELECT * FROM avvsies.COMUNI' ;
	EXECUTE IMMEDIATE 'CREATE TABLE STATI_SXALLTF AS SELECT * FROM avvsies.STATI' ;



END XAT_SALVA_TABELLE_PRE_ALLINEA;