CREATE OR REPLACE PROCEDURE XBA_CREA_LOG_BONIFICA_AVVOCATI IS

BEGIN
	-- Inizio XBA_CREA_LOG_BONIFICA_AVVOCATI. Preparazione della tabella XBA_LOG_BONIFICA_AVVOCATI.
	EXECUTE IMMEDIATE 'CREATE TABLE XBA_LOG_BONIFICA_AVVOCATI ( ELABORAZIONE VARCHAR2(300), ELABORATI NUMBER, DATA_ESECUZIONE DATE );' ;

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('Eseguita XBA_CREA_LOG_BONIFICA_AVVOCATI. La tabella XBA_LOG_BONIFICA_AVVOCATI appena generata conterrà i dettagli delle attività di bonifica. ',
			NULL,
			CURRENT_DATE);
	
END XBA_CREA_LOG_BONIFICA_AVVOCATI;