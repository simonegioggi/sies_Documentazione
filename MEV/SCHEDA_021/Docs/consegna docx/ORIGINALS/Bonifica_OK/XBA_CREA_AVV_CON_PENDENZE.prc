CREATE OR REPLACE PROCEDURE XBA_CREA_AVV_CON_PENDENZE IS

BEGIN
	-- Inizio XBA_CREA_AVV_CON_PENDENZE. Preparazione della tabella XBA_AVVOCATI_CON_PENDENZE.
	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('Inizio XBA_CREA_AVV_CON_PENDENZE. La tabella XBA_AVVOCATI_CON_PENDENZE conterrà i dati di transito per eseguire la bonifica AVVOCATO. ',
			NULL,
			CURRENT_DATE);

	--EXECUTE IMMEDIATE 'DROP TABLE IF EXISTS XBA_AVVOCATI_CON_PENDENZE';
	EXECUTE IMMEDIATE 'CREATE TABLE XBA_AVVOCATI_CON_PENDENZE AS (SELECT * FROM AVVOCATO WHERE 1=2)';

	EXECUTE IMMEDIATE 'ALTER TABLE XBA_AVVOCATI_CON_PENDENZE 
							   ADD ( AMBIENTE VARCHAR2(4),
									 NUM_PENDENZE number(11),
									 ID_AVV_CERT_REGINDE NUMBER(38,0) )';	

	INSERT INTO XBA_LOG_BONIFICA_AVVOCATI
	VALUES('Fine XBA_CREA_AVV_CON_PENDENZE. ',
			NULL,
			CURRENT_DATE);

END XBA_CREA_AVV_CON_PENDENZE;